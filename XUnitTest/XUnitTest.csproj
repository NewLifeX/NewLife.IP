<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyTitle>IP地址库单元测试</AssemblyTitle>
    <Description>覆盖IP转换、地址解析与并发稳定性的xUnit自动化测试集。</Description>
    <OutputPath>..\Bin\UnitTest</OutputPath>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- xUnit v3 基于 Microsoft.Testing.Platform：VS2026 与 dotnet test 均走 MTP 进程内执行，
       省去 VSTest 宿主启动与独立发现阶段，测试项目必须为可执行程序 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
    <PackageReference Include="NewLife.Core" Version="12.0.2026.1024" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NewLife.IP\NewLife.IP.csproj" />
  </ItemGroup>

  <!-- 集成测试数据：仓库根目录的 IP 库复制到输出目录 Data/，保证离线/CI 环境下 Ip.Init 直接命中本地文件 -->
  <ItemGroup>
    <None Include="..\ip.gz" Link="Data\ip.gz" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
