<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyTitle>IP地址库单元测试</AssemblyTitle>
    <Description>覆盖IP转换、地址解析与并发稳定性的xUnit自动化测试集。</Description>
    <OutputPath>..\Bin\UnitTest</OutputPath>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="NewLife.Core" Version="12.0.2026.1017-beta1103" />
    <PackageReference Include="NewLife.UnitTest" Version="1.1.2026.301-beta0617" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NewLife.IP\NewLife.IP.csproj" />
  </ItemGroup>

  <!-- 集成测试数据：仓库根目录的 IP 库复制到输出目录 Data/，保证离线/CI 环境下 Ip.Init 直接命中本地文件 -->
  <ItemGroup>
    <None Include="..\ip.gz" Link="Data\ip.gz" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
