<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AotSmoke</RootNamespace>
    <!-- JIT 运行与 NativeAOT 发布共用本工程：发布用 dotnet publish -c Release -r <rid> -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NewLife.IP\NewLife.IP.csproj" />
  </ItemGroup>

  <!-- 复用单元测试的数据库构造器，保证冒烟数据与单测一致（纯 BCL 实现，AOT 安全） -->
  <ItemGroup>
    <Compile Include="..\XUnitTest\TestDbBuilder.cs" Link="TestDbBuilder.cs" />
  </ItemGroup>
</Project>
